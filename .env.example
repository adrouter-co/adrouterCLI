# Local AdRouterCLI configuration. Copy to .env.local; it is ignored.
ADROUTER_API_URL=http://localhost:8787
ADROUTER_API_KEY=replace_with_the_same_token_as_router_backend
ADROUTER_AD_MODE=live
ADROUTER_RUNTIME_MODE=live
ADROUTER_MODEL_ROUTE=deepseek-v4-flash
# Deprecated compatibility input. Routed outcomes are never suppressed.
ADROUTER_MIN_AD_TIER=3
